{
    "name": "portrino/cms-observer-client-wordpress",
    "description": "CMS Observer Client - Reports WordPress core, PHP/DB version and installed plugins to a CMS Observer instance",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "keywords": [
        "WordPress",
        "plugin",
        "monitoring"
    ],
    "authors": [
        {
            "name": "Axel B\u00f6swetter",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "ergebnis/composer-normalize": "^2.30",
        "friendsofphp/php-cs-fixer": "^3.14",
        "mockery/mockery": "^1.6",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "seld/jsonlint": "^1.9",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "tomasvotruba/type-coverage": "^2.0",
        "typo3/coding-standards": "^0.8 || ^0.9"
    },
    "autoload": {
        "psr-4": {
            "Portrino\\CmsObserverClient\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Portrino\\CmsObserverClient\\Tests\\": "Tests/"
        },
        "exclude-from-classmap": [
            "Tests/Unit/Fixtures/"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "ergebnis/composer-normalize": true
        },
        "bin-dir": ".Build/bin",
        "platform": {
            "php": "8.1.0"
        },
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "installer-name": "cms-observer-client"
    },
    "scripts": {
        "ci": [
            "@ci:composer",
            "@ci:static"
        ],
        "ci:composer": [
            "@ci:composer:analyze-dependencies",
            "@ci:composer:audit",
            "@ci:composer:normalize",
            "@ci:composer:psr-verify"
        ],
        "ci:composer:analyze-dependencies": "./.Build/bin/composer-dependency-analyser --config=./Build/composer-dependency-analyser.php",
        "ci:composer:audit": "@composer audit --abandoned=ignore --ignore-unreachable",
        "ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
        "ci:composer:psr-verify": "@composer dumpautoload --optimize --strict-psr",
        "ci:json:lint": "find . ! -path '*.Build/*' ! -path '*node_modules/*' -name '*.json' | xargs -r php .Build/bin/jsonlint -q",
        "ci:php": [
            "@ci:php:cs-fixer",
            "@ci:php:lint",
            "@ci:php:rector",
            "@ci:php:stan"
        ],
        "ci:php:cs-fixer": "./.Build/bin/php-cs-fixer fix --config ./Build/php-cs-fixer.php -v --dry-run --using-cache no --diff",
        "ci:php:lint": "find *.php Classes Tests -name '*.php' -print0 | xargs -r -0 -n 1 -P 4 php -l",
        "ci:php:rector": "./.Build/bin/rector process --ansi --config ./Build/rector.php --dry-run --no-progress-bar",
        "ci:php:stan": "./.Build/bin/phpstan analyse -c ./Build/phpstan.neon --no-progress",
        "ci:static": [
            "@ci:json:lint",
            "@ci:php:cs-fixer",
            "@ci:php:lint",
            "@ci:php:rector",
            "@ci:php:stan",
            "@ci:yaml:lint"
        ],
        "ci:yaml:lint": "find . ! -path '*.Build/*' ! -path '*node_modules/*' -regextype egrep -regex '.*.ya?ml$' | xargs -r php ./.Build/bin/yaml-lint",
        "fix": [
            "@fix:php"
        ],
        "fix:php": [
            "@fix:php:cs",
            "@fix:php:rector"
        ],
        "fix:php:cs": "./.Build/bin/php-cs-fixer fix --config ./Build/php-cs-fixer.php",
        "fix:php:rector": "./.Build/bin/rector process --ansi --config ./Build/rector.php --no-progress-bar",
        "test": [
            "@test:unit"
        ],
        "test:unit": "@test:unit:coverage --no-coverage",
        "test:unit:coverage": "./.Build/bin/phpunit -c ./Build/phpunit.xml.dist"
    },
    "scripts-descriptions": {
        "ci": "Runs all composer and static code checks.",
        "ci:composer": "Runs the composer checks (dependencies, audit, normalize, PSR-4).",
        "ci:php": "Runs all static checks for the PHP files.",
        "ci:static": "Runs all static code checks (syntax, style, types).",
        "fix": "Runs all fixers.",
        "fix:php": "Runs all fixers for the PHP code.",
        "test": "Runs all tests.",
        "test:unit": "Runs the unit tests.",
        "test:unit:coverage": "Runs the unit tests with code coverage."
    }
}
